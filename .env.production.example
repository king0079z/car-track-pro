# ══════════════════════════════════════════════════════════════════════════════
# CarTrack Pro — Production Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:   cp .env.production.example .env.production
# 2. Fill in all values marked with  <CHANGE THIS>
# 3. Run:  docker compose --env-file .env.production up -d --build
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=cartrack
DB_PASSWORD=<CHANGE THIS — use a strong password>
DB_NAME=cartrack_db

# ── Security (REQUIRED) ────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE THIS — 64-char random hex string>

# ── JWT ────────────────────────────────────────────────────────────────────
TOKEN_EXPIRE_MINUTES=480

# ── CORS — add every hostname/IP that the browser connects from ────────────
# Example: ALLOWED_ORIGINS=http://192.168.1.50,https://cartrack.yourdomain.com,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Dahua cloud (Easy4IP P2P — DMSS-style, no on-site PC) ─────────────────
# Set on VPS/backend only (not Vercel). Survives redeploy without cameras.json.
# DAHUA_DEVICE_SERIAL=BF0E4C7GAGB833C
# DAHUA_PASSWORD=device-password-from-dmss
# DAHUA_CONNECTION_MODE=p2p
# DAHUA_P2P_PREWARM_ON_STARTUP=true
# LIVE_24_7_ENABLED=true
# LIVE_RESUME_ON_STARTUP=true

# ── HTTP Port (host port mapped to nginx container) ────────────────────────
HTTP_PORT=80
