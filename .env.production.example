# ══════════════════════════════════════════════════════════════════════════════
# CarTrack Pro — Production Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:   cp .env.production.example .env.production
# 2. Fill in all values marked with  <CHANGE THIS>
# 3. Run:  docker compose --env-file .env.production up -d --build
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=cartrack
DB_PASSWORD=<CHANGE THIS — use a strong password>
DB_NAME=cartrack_db

# ── Security (REQUIRED) ────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE THIS — 64-char random hex string>

# ── JWT ────────────────────────────────────────────────────────────────────
TOKEN_EXPIRE_MINUTES=480

# ── CORS — add every hostname/IP that the browser connects from ────────────
# Example: ALLOWED_ORIGINS=http://192.168.1.50,https://cartrack.yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── HTTP Port (host port mapped to nginx container) ────────────────────────
HTTP_PORT=80
