# CarTrack — pre-filled cloud env for cartrackpro.duckdns.org (Hetzner VPS)
# Copied to .env.cloud by bootstrap-vps.sh / setup-oracle.sh. NEVER commit .env.cloud.
#
# Secrets (SECRET_KEY, DAHUA_PASSWORD) are filled by the installer or bootstrap script.

# --- App security ---
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
DEBUG=false

# --- Same-origin (all-in-one: UI + API on https://cartrackpro.duckdns.org) ---
ALLOWED_ORIGINS=https://cartrackpro.duckdns.org

# --- Database (SQLite on persistent volume — survives container redeploys) ---
DATABASE_URL=sqlite:///./cartrack.db

# --- Live 24/7 ANPR ---
LIVE_24_7_ENABLED=true
LIVE_RESUME_ON_STARTUP=false
LIVE_PROBE_CAMERAS_ON_STARTUP=false
LIVE_SEGMENT_MAX_GB=25
ANALYSIS_MEDIA_RETENTION_HOURS=24
USE_GPU=false

# --- Dahua Hero A1 — CarTrack Cloud (VPS tunnel, no shop PC / no Imou app) ---
DAHUA_ENABLED=true
DAHUA_DEVICE_SERIAL=BF0E4C7GAGB833C
DAHUA_PASSWORD=CHANGE_ME_device_password
DAHUA_USERNAME=admin
DAHUA_CONNECTION_MODE=cartrack_cloud
DAHUA_DEVICE_TYPE=DH-H3A
DAHUA_STREAM=sub
DAHUA_P2P_PREWARM_ON_STARTUP=true
