# All-in-one HTTPS for CarTrack on a single VM (Oracle Cloud / any host).
# CADDY_DOMAIN is injected from the environment (e.g. mycam.duckdns.org).
# Caddy obtains a free Let's Encrypt certificate automatically on first boot.
#
#   https://<domain>/api/*  +  /ws   -> FastAPI backend (REST + live WebSocket)
#   https://<domain>/*               -> React single-page app (static)

{$CADDY_DOMAIN} {
	encode gzip

	# Security headers. `upgrade-insecure-requests` makes the browser silently
	# fetch any stray http:// subresource over https instead — this removes the
	# "some parts of this site are not secure" (mixed-content) padlock warning,
	# whatever the source (cached asset, pasted URL, or extension injection).
	header {
		Content-Security-Policy "upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Backend: REST API (/api/*), VisionFlow live ANPR (/vf/*), + WebSocket (/ws).
	@backend path /api/* /vf/* /ws /ws/*
	handle @backend {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			# Allow long-lived WebSocket / live-stream connections (no buffering).
			flush_interval -1
		}
	}

	# Everything else: the React SPA, with client-side routing fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
