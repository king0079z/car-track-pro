# ── CarTrack CLOUD backend env ───────────────────────────────────────────────
# Copy to .env.cloud and fill in real values. NEVER commit the real .env.cloud.
#   cp .env.cloud.example .env.cloud

# --- App security ---
# Generate one with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
DEBUG=false

# --- CORS: allowed frontend origin(s), comma-separated, no trailing slash ---
# All-in-one (Oracle) deploy: this is your own https://<domain> — setup-oracle.sh
# fills it in automatically. Split deploy (Vercel): set it to your Vercel URL.
ALLOWED_ORIGINS=https://CHANGE_ME.duckdns.org

# --- Database (SQLite is fine for a single cloud node) ---
DATABASE_URL=sqlite:///./cartrack.db

# --- Live engine: do NOT auto-open USB cams; the Dahua tunnel is what we want ---
LIVE_RESUME_ON_STARTUP=false
LIVE_PROBE_CAMERAS_ON_STARTUP=false
LIVE_24_7_ENABLED=true
USE_GPU=false

# ── Dahua Easy4IP cloud (this is the DMSS model) ─────────────────────────────
# With serial + password set, the backend auto-starts the Easy4IP P2P tunnel on
# boot and pulls the camera stream from Dahua's cloud — exactly like DMSS does.
DAHUA_ENABLED=true
DAHUA_DEVICE_SERIAL=BF0E4C7GAGB833C
DAHUA_PASSWORD=CHANGE_ME_device_password
DAHUA_USERNAME=admin
DAHUA_CONNECTION_MODE=p2p
DAHUA_DEVICE_TYPE=DH-H3A
DAHUA_STREAM=sub
DAHUA_P2P_PREWARM_ON_STARTUP=true
