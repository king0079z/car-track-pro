# Vercel → Project → Settings → Environment Variables (Production + Preview)
#
# REQUIRED: HTTPS URL of your CarTrack FastAPI backend (NOT the Vercel URL).
# Vercel only hosts the React UI. RTSP / YOLO / Dahua P2P run on the backend host.
#
# Examples:
#   VITE_API_URL=https://cartrack-api.onrender.com
#   VITE_API_URL=https://api.yourdomain.com
#
VITE_API_URL=https://YOUR-BACKEND-HOST.example.com

# Optional: explicit WebSocket URL (defaults to VITE_API_URL with wss://)
# VITE_WS_URL=wss://YOUR-BACKEND-HOST.example.com/ws
